# Neggo App — Variables de entorno
# Copiar este archivo a .env y completar los valores

# PostgreSQL
POSTGRES_PASSWORD=neggo_pass

# JWT (cambiar por un string aleatorio largo)
JWT_SECRET=cambiar_en_produccion_abc123

# Odoo 19 — neggo.odoo.com
ODOO_URL=https://neggo.odoo.com
ODOO_DB=neggo
ODOO_USER_ID=showeronlinegp@gmail.com
ODOO_API_KEY=tu_api_key

# OpenAI (para OCR de facturas y funciones de IA)
OPENAI_API_KEY=sk-...

# Evolution API (WhatsApp). Generar una clave propia: openssl rand -hex 16
# La misma clave la usan el contenedor evolution y el backend. No commitear el .env.
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=cambiar_esta_clave
EVOLUTION_INSTANCE=neggo
# Otro número de WhatsApp. Los estados salen solo por esta instancia.
EVOLUTION_STATUS_INSTANCE=neggo-estados
EVOLUTION_SERVER_URL=http://localhost:8080
WHATSAPP_MAX_ATTEMPTS=3

# Backup semanal a Google Drive. El id es el de la URL de la carpeta, después de /folders/
# El JSON del service account va en secrets/drive-sa.json (no se commitea). Ver backup/README.md
DRIVE_FOLDER_ID=
BACKUP_KEEP=8
# El automático es el viernes a las 15, hora Argentina. Si la PC está apagada, se hace al prenderla.

# API del agente (Grok Bot). Generar con: openssl rand -hex 32
AGENTE_API_KEY=
# Base del link a la tienda (si no, usa ODOO_URL)
WHATSAPP_SHOP_URL=
