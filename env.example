# Copiar este archivo a .env y completar los valores
# cp env.example .env

# ── Base de datos ────────────────────────────────────────────
POSTGRES_PASSWORD=neggo_pass

# ── Seguridad ────────────────────────────────────────────────
JWT_SECRET=cambiar_esto_por_algo_seguro_abc123xyz

# ── Odoo ─────────────────────────────────────────────────────
ODOO_URL=https://neggo.odoo.com
ODOO_DB=neggo
ODOO_USER_ID=2
ODOO_API_KEY=tu_api_key

# ── OpenAI (opcional) ────────────────────────────────────────
OPENAI_API_KEY=sk-...

# API del agente (Grok Bot). Generar con: openssl rand -hex 32
AGENTE_API_KEY=
# Base del link a la tienda (si no, usa ODOO_URL)
WHATSAPP_SHOP_URL=
