    "/productos": {
      "get": {
        "tags": [
          "Productos"
        ],
        "operationId": "listarProductos",
        "summary": "Productos de Neggo para recomendar",
        "description": "Productos de Neggo con precio de venta. Neggo no lleva stock en Odoo: un producto agotado se archiva. Por eso `stock: true` quiere decir disponible (activo y no archivado). Sin el parámetro vienen solo los disponibles; `stock=false` trae los agotados. `rubro` acepta el mismo valor que viene en el cliente e ignora tildes y \"de\" (\"Tecnologia\" = \"Tecnología\"). Orden: con stock primero, después por nombre.",
        "parameters": [
          {
            "name": "rubro",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Rubro, tal cual viene en el cliente",
            "example": "Librería"
          },
          {
            "name": "stock",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "true = disponibles (por defecto); false = agotados",
            "example": true
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Búsqueda por nombre",
            "example": "cargador"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Página, desde 1"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Elementos por página (máximo 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "pagination"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Producto"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Paginacion"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": 32400,
                      "nombre": "Auricular inalámbrico c/pantalla JK-604",
                      "precio": 5474,
                      "rubro": "Tecnología",
                      "categoria": "Tecnología",
                      "stock": true,
                      "url": "https://neggo.odoo.com/shop/itm10-auricular-inalambrico-c-pantalla-jk-604-33275",
                      "imagen": "https://neggo.odoo.com/web/image/product.template/33275/image_512"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 20,
                    "total": 1,
                    "pages": 1
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "422": {
            "$ref": "#/components/responses/Validacion"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          },
          "503": {
            "$ref": "#/components/responses/Deshabilitada"
          }
        }
      }
    },
    "/feedback": {
