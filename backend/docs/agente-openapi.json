  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key del agente (AGENTE_API_KEY): `Authorization: Bearer <API_KEY>`"
      }
    },
    "schemas": {
      "Etapa": {
        "type": "string",
        "enum": [
          "pendiente",
          "dia_1",
          "dia_7",
          "dia_15",
          "finalizado"
        ],
        "description": "Etapa de la cadencia del bot. Sin registro = pendiente."
      },
      "Paginacion": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total",
          "pages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 16
          },
          "pages": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "ProductoComprado": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "cantidad",
          "precio"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "product.product de Odoo"
          },
          "nombre": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "precio": {
            "type": "number",
            "description": "Precio unitario con impuestos, 2 decimales"
          }
        }
      },
      "Compra": {
        "type": "object",
        "required": [
          "id",
          "referencia",
          "fecha",
          "monto",
          "estado",
          "productos"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "`pos-<ticket>`, o `venta-<pedido>` cuando agrupa seña y saldo",
            "example": "pos-555"
          },
          "referencia": {
            "type": "string",
            "description": "Número del ticket, o del pedido si agrupa varios"
          },
          "fecha": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T10:00:00-03:00",
            "description": "Fecha del primer ticket"
          },
          "monto": {
            "type": "number",
            "description": "Total cobrado con impuestos (suma de los tickets)"
          },
          "estado": {
            "type": "string",
            "enum": [
              "pagado",
              "facturado"
            ],
            "description": "En una compra agrupada, el del último ticket"
          },
          "productos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductoComprado"
            },
            "description": "Solo productos físicos (no señas ni envíos)"
          }
        }
      },
      "Seguimiento": {
        "type": "object",
        "required": [
          "etapa",
          "ultimo_contacto",
          "proxima_accion"
        ],
        "properties": {
          "etapa": {
            "$ref": "#/components/schemas/Etapa"
          },
          "ultimo_contacto": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T10:00:00-03:00",
            "nullable": true
          },
          "proxima_accion": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25",
            "nullable": true
          }
        }
      },
      "ClienteNuevo": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "contacto",
          "telefono",
          "ciudad",
          "rubro",
          "no_contactar",
          "fecha_primera_compra",
          "cantidad_compras",
          "compras",
          "seguimiento"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "res.partner de Odoo"
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del cliente en Odoo (suele ser el comercio)"
          },
          "contacto": {
            "type": "string",
            "nullable": true,
            "description": "Nombre de la persona: el que guardó el agente o, si no hay, el primer contacto del cliente en Odoo"
          },
          "telefono": {
            "type": "string",
            "nullable": true,
            "description": "Celular argentino +549…; null si el número no es válido",
            "example": "+5492477000000"
          },
          "ciudad": {
            "type": "string",
            "nullable": true
          },
          "rubro": {
            "type": "string",
            "nullable": true,
            "description": "Categoría en la que más compró. Sirve tal cual para GET /productos?rubro="
          },
          "no_contactar": {
            "type": "boolean"
          },
          "fecha_primera_compra": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25"
          },
          "cantidad_compras": {
            "type": "integer"
          },
          "compras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Compra"
            },
            "description": "De la más nueva a la más vieja"
          },
          "seguimiento": {
            "$ref": "#/components/schemas/Seguimiento"
          }
        }
      },
      "SeguimientoPatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "etapa": {
            "$ref": "#/components/schemas/Etapa"
          },
          "ultimo_contacto": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T10:00:00-03:00",
            "nullable": true,
            "description": "ISO 8601 (fecha o datetime); no futuro"
          },
          "proxima_accion": {
            "type": "string",
            "format": "date",
            "example": "2026-10-25",
            "nullable": true
          }
        }
      },
      "SeguimientoCompleto": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Seguimiento"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "no_contactar": {
                "type": "boolean"
              },
              "no_contactar_at": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-17T10:00:00-03:00",
                "nullable": true
              },
              "contacto": {
                "type": "string",
                "nullable": true
              },
              "actualizado": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-17T10:00:00-03:00",
                "nullable": true
              }
            }
          }
        ]
      },
      "ClientePatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "no_contactar": {
            "type": "boolean"
          },
          "contacto": {
            "type": "string",
            "nullable": true,
            "maxLength": 200,
            "description": "Nombre de la persona con la que hablás; null o \"\" lo borra"
          }
        }
      },
      "ClienteActualizado": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nombre": {
            "type": "string"
          },
          "contacto": {
            "type": "string",
            "nullable": true
          },
          "no_contactar": {
            "type": "boolean"
          },
          "seguimiento": {
            "$ref": "#/components/schemas/Seguimiento"
          }
        }
      },
      "InteraccionNueva": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "mensaje"
        ],
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T10:00:00-03:00",
            "description": "Por defecto, ahora. No futuro."
          },
          "tipo": {
            "type": "string",
            "enum": [
              "enviado",
              "recibido"
            ]
          },
          "etapa": {
            "$ref": "#/components/schemas/Etapa"
          },
          "mensaje": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "respuesta": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          }
        }
      },
      "Interaccion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "cliente_id": {
            "type": "integer"
          },
          "fecha": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T10:00:00-03:00"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "enviado",
              "recibido"
            ]
          },
          "etapa": {
            "type": "string",
            "enum": [
              "pendiente",
              "dia_1",
              "dia_7",
              "dia_15",
              "finalizado"
            ],
            "nullable": true
          },
          "mensaje": {
            "type": "string"
          },
          "respuesta": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Producto": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "precio",
          "rubro",
          "categoria",
          "stock",
          "url",
          "imagen"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "product.product de Odoo"
          },
          "nombre": {
            "type": "string"
          },
          "precio": {
            "type": "number",
            "description": "Precio de venta de Odoo"
          },
          "rubro": {
            "type": "string",
            "nullable": true
          },
          "categoria": {
            "type": "string",
            "nullable": true,
            "description": "Categoría tal cual está en Odoo"
          },
          "stock": {
            "type": "boolean",
            "description": "true = disponible (no archivado)"
          },
          "url": {
            "type": "string",
            "nullable": true,
            "description": "Link a la tienda; null si no está publicado"
          },
          "imagen": {
            "type": "string",
            "nullable": true,
            "description": "Foto pública (512 px); null si no está publicado"
          }
        }
      },
      "FeedbackNuevo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "mensaje"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "falta",
              "error",
              "mejora",
              "comentario"
            ],
            "description": "falta = un dato que necesitás; error = algo que no anda; mejora = cómo lo harías mejor"
          },
          "endpoint": {
            "type": "string",
            "maxLength": 200,
            "nullable": true,
            "example": "/productos"
          },
          "mensaje": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "Feedback": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "tipo": {
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "nullable": true
          },
          "mensaje": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-17T10:00:00-03:00"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ErrorValidacion": {
        "type": "object",
        "required": [
          "success",
          "error",
          "details"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Datos inválidos"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "NoAutorizado": {
        "description": "Falta la API key o es incorrecta",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "API key inválida"
            }
          }
        }
      },
      "Deshabilitada": {
        "description": "AGENTE_API_KEY no está configurada en el servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "API del agente deshabilitada"
            }
          }
        }
      },
      "NoEncontrado": {
        "description": "Cliente inexistente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "Cliente inexistente"
            }
          }
        }
      },
      "Validacion": {
        "description": "Datos inválidos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorValidacion"
            },
            "example": {
              "success": false,
              "error": "Datos inválidos",
              "details": [
                {
                  "campo": "dias",
                  "error": "Tiene que ser un entero de 1 a 90"
                }
              ]
            }
          }
        }
      },
      "NoContactar": {
        "description": "El cliente pidió no recibir mensajes",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "El cliente pidió no recibir mensajes"
            }
          }
        }
      },
      "OdooCaido": {
        "description": "Odoo no responde",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "No pude leer Odoo"
            }
          }
        }
      },
      "ErrorInterno": {
        "description": "Error interno",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
