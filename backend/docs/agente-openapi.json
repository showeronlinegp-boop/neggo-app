          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackNuevo"
              },
              "example": {
                "tipo": "falta",
                "endpoint": "/productos",
                "mensaje": "Me sirve tener el stock real por producto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Guardado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Feedback"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": 1,
                    "tipo": "falta",
                    "endpoint": "/productos",
                    "mensaje": "Me sirve tener el stock real por producto",
                    "fecha": "2026-10-22T10:30:00-03:00"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "422": {
            "$ref": "#/components/responses/Validacion"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          },
          "503": {
            "$ref": "#/components/responses/Deshabilitada"
          }
        }
      },
