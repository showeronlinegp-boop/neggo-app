{
  "openapi": "3.0.3",
  "info": {
    "title": "API del agente de Neggo (Grok Bot)",
    "version": "1.0.0",
    "description": "API para el seguimiento por WhatsApp de los **clientes nuevos** de Neggo Mayorista: los que hicieron su primera compra en los últimos N días.\n\n- No escribe nada en Odoo: solo lo lee. Lo que guarda (etapa, mensajes, no contactar) queda en la base de la app.\n- Compra = ticket del POS de Neggo pagado o facturado. Seña y saldo de un mismo pedido son una sola compra.\n- Fechas en hora de Argentina (UTC−3): `YYYY-MM-DD` y datetimes ISO 8601 con offset (`2026-10-22T10:15:00-03:00`). Un datetime sin offset se toma como hora de Argentina.\n- Textos en UTF-8. Un texto con caracteres rotos (U+FFFD) se rechaza con 422.\n- Si algo de la API no te sirve o te falta, mandalo a `POST /feedback`."
  },
  "servers": [
    {
      "url": "/api/agente",
      "description": "Backend de Neggo App"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Clientes",
      "description": "Clientes nuevos, seguimiento y no contactar"
    },
    {
      "name": "Interacciones",
      "description": "Mensajes enviados y recibidos"
    },
    {
      "name": "Productos",
      "description": "Productos para recomendar"
    },
    {
      "name": "Feedback",
      "description": "Lo que el agente quiere que cambie en la API"
    },
    {
      "name": "Documentación",
      "description": "Públicas, sin datos"
    }
  ],
  "paths": {
    "/clientes/nuevos": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "operationId": "listarClientesNuevos",
        "summary": "Clientes con primera compra en los últimos N días",
        "description": "Se calcula en vivo contra Odoo (caché de 5 minutos; `refresh=1` la saltea). Un cliente es nuevo si su primera compra válida, en toda la historia, cae entre hoy y los `dias - 1` días anteriores. Orden: `fecha_primera_compra` desc. Excluye \"Consumidor Final\", \"RMA\" y los tickets sin cliente.",
        "parameters": [
          {
            "name": "dias",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 15
            },
            "description": "Ventana en días, contando hoy",
            "example": 15
          },
          {
            "name": "etapa",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pendiente",
                "dia_1",
                "dia_7",
                "dia_15",
                "finalizado"
              ]
            },
            "description": "Solo los clientes en esta etapa del bot"
          },
          {
            "name": "no_contactar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Mandá false para traer solo los que se pueden contactar",
            "example": false
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Página, desde 1"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Elementos por página (máximo 100)"
          },
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Saltea la caché de 5 minutos"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "pagination"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ClienteNuevo"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Paginacion"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": 123,
                      "nombre": "Kiosco Don Pepe",
                      "contacto": "José Pérez",
                      "telefono": "+5492477000000",
                      "ciudad": "Pergamino",
                      "rubro": "Librería",
                      "no_contactar": false,
                      "fecha_primera_compra": "2026-10-10",
                      "cantidad_compras": 2,
                      "compras": [
                        {
                          "id": "pos-555",
                          "referencia": "Pedido 00012-003-0004",
                          "fecha": "2026-10-10T16:20:00-03:00",
                          "monto": 45000,
                          "estado": "pagado",
                          "productos": [
                            {
                              "id": 10,
                              "nombre": "Producto X",
                              "cantidad": 3,
                              "precio": 15000
                            }
                          ]
                        }
                      ],
                      "seguimiento": {
                        "etapa": "dia_7",
                        "ultimo_contacto": "2026-10-17T10:00:00-03:00",
                        "proxima_accion": "2026-10-25"
                      }
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 20,
                    "total": 1,
                    "pages": 1
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "422": {
            "$ref": "#/components/responses/Validacion"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          },
          "502": {
            "$ref": "#/components/responses/OdooCaido"
          },
          "503": {
            "$ref": "#/components/responses/Deshabilitada"
          }
        }
      }
    },
    "/clientes/{id}": {
      "patch": {
        "tags": [
          "Clientes"
        ],
        "operationId": "actualizarCliente",
        "summary": "Marcar no contactar o guardar el nombre del contacto",
        "description": "Tiene que venir al menos un campo. Si `no_contactar` pasa a true, la etapa queda en `finalizado` y se deja una nota en la ficha del cliente para el equipo. Desmarcarlo no cambia la etapa.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID del cliente (res.partner de Odoo)",
            "example": 1596
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientePatch"
              },
              "example": {
                "no_contactar": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ClienteActualizado"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": 123,
                    "nombre": "Kiosco Don Pepe",
                    "contacto": "José Pérez",
                    "no_contactar": true,
                    "seguimiento": {
                      "etapa": "finalizado",
                      "ultimo_contacto": "2026-10-17T10:00:00-03:00",
                      "proxima_accion": "2026-10-25"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "422": {
            "$ref": "#/components/responses/Validacion"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          },
          "502": {
            "$ref": "#/components/responses/OdooCaido"
          },
          "503": {
            "$ref": "#/components/responses/Deshabilitada"
          }
        }
      }
    },
    "/clientes/{id}/seguimiento": {
      "patch": {
        "tags": [
          "Clientes"
        ],
        "operationId": "actualizarSeguimiento",
        "summary": "Actualizar etapa, último contacto o próxima acción",
        "description": "Solo cambia los campos que mandás; tiene que venir al menos uno. `ultimo_contacto` no puede ser futuro (hay 5 minutos de margen). `ultimo_contacto` y `proxima_accion` aceptan null para borrarlos.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID del cliente (res.partner de Odoo)",
            "example": 1596
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeguimientoPatch"
              },
              "example": {
                "etapa": "dia_7",
                "ultimo_contacto": "2026-10-17T10:00:00-03:00",
                "proxima_accion": "2026-10-25"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SeguimientoCompleto"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": 123,
                    "etapa": "dia_7",
                    "ultimo_contacto": "2026-10-17T10:00:00-03:00",
                    "proxima_accion": "2026-10-25",
                    "no_contactar": false,
                    "no_contactar_at": null,
                    "contacto": "José Pérez",
                    "actualizado": "2026-10-17T10:00:05-03:00"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "422": {
            "$ref": "#/components/responses/Validacion"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          },
          "502": {
            "$ref": "#/components/responses/OdooCaido"
          },
          "503": {
            "$ref": "#/components/responses/Deshabilitada"
          }
        }
      }
    },
    "/clientes/{id}/interacciones": {
      "post": {
        "tags": [
          "Interacciones"
        ],
        "operationId": "registrarInteraccion",
        "summary": "Registrar un mensaje enviado o recibido",
        "description": "Un `enviado` actualiza `ultimo_contacto` del seguimiento (si es más nuevo que el que había). Un `enviado` a un cliente con `no_contactar` → 409; los `recibido` se guardan igual.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "ID del cliente (res.partner de Odoo)",
            "example": 1596
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InteraccionNueva"
              },
              "example": {
                "fecha": "2026-10-17T10:00:00-03:00",
                "tipo": "enviado",
                "etapa": "dia_7",
                "mensaje": "Hola José, ¿qué tal te fue con...?",
                "respuesta": null
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Interaccion"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": 1,
                    "cliente_id": 123,
                    "fecha": "2026-10-17T10:00:00-03:00",
                    "tipo": "enviado",
                    "etapa": "dia_7",
                    "mensaje": "Hola José, ¿qué tal te fue con...?",
                    "respuesta": null
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NoAutorizado"
          },
          "404": {
            "$ref": "#/components/responses/NoEncontrado"
          },
          "409": {
            "$ref": "#/components/responses/NoContactar"
          },
          "422": {
            "$ref": "#/components/responses/Validacion"
          },
          "500": {
            "$ref": "#/components/responses/ErrorInterno"
          },
          "502": {
            "$ref": "#/components/responses/OdooCaido"
          },
          "503": {
            "$ref": "#/components/responses/Deshabilitada"
          }
        }
      },
